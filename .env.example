# Copy to .env and fill in. Never commit .env.

# --- LMS -------------------------------------------------------------------
LMS_URL=https://lms.nust.edu.pk
LMS_USERNAME=
LMS_PASSWORD=
# Your section letter. Combined courses publish one submission link per
# section ("Lab 7 Submission_sec_B", "BSCS-14C", ...); links tagged with a
# different section are ignored. Leave empty to disable filtering.
LMS_SECTION=A
# How far back to look for overdue items that still accept submissions.
LMS_LOOKBACK_DAYS=14
# NUST's server only supports legacy TLS renegotiation.
LMS_LEGACY_TLS=true

# --- Reminders -------------------------------------------------------------
# A reminder fires once when a task is first seen, then once as it crosses
# each of these thresholds (hours before the deadline), then once if overdue.
REMIND_HOURS=72,24,6,1
TIMEZONE=Asia/Karachi
STATE_FILE=.state/state.json

# --- Notification channels -------------------------------------------------
# Comma-separated: console, ntfy, telegram, email, whatsapp
NOTIFIERS=console

# ntfy (push notifications, no signup: install the ntfy app, subscribe to topic)
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=

# Telegram (create a bot with @BotFather, then get your chat id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email via SMTP (for Gmail use an App Password, not your account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=

# WhatsApp via CallMeBot (free; see https://www.callmebot.com/blog/free-api-whatsapp-messages/)
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=
